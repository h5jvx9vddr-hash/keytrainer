<Window x:Class="KeyTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyTrainer – Erkennungstest"
        Width="440" Height="560" MinWidth="320" MinHeight="300"
        Background="#111111" Foreground="#EEEEEE"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Erkennungstest (Phase 1)" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#AAAAAA"
                       Text="Zeigt jede erkannte Tastenkombination an – auch wenn ein anderes Programm im Vordergrund ist. Nur im Speicher, nichts wird gespeichert." />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                <Button x:Name="StartButton" Content="Erfassung starten" Padding="14,6"
                        Click="OnToggle" />
                <Button Content="Leeren" Padding="14,6" Margin="8,0,0,0" Click="OnClear" />
                <Button Content="Log-Ordner" Padding="14,6" Margin="8,0,0,0" Click="OnOpenLog" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Erfassung aus" Foreground="#AAAAAA" Margin="0,0,0,8" />
        </StackPanel>
        <ListBox x:Name="TokenList" Background="#1C1C1C" Foreground="#EEEEEE" BorderThickness="0"
                 FontFamily="Consolas" FontSize="15" />
    </DockPanel>
</Window>
