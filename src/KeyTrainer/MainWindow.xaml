<Window x:Class="KeyTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyTrainer"
        Icon="app.ico"
        Width="620" Height="760" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- One key cap ("Strg") or the "+" between them -->
        <DataTemplate x:Key="KeyPartTemplate">
            <Border x:Name="Cap" Margin="0,0,4,0" Padding="8,3" CornerRadius="5" BorderThickness="1,1,1,2"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <TextBlock x:Name="Label" Text="{Binding Label}" FontWeight="SemiBold" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="Cap" Property="Background" Value="Transparent" />
                    <Setter TargetName="Cap" Property="BorderThickness" Value="0" />
                    <Setter TargetName="Cap" Property="Padding" Value="0,3" />
                    <Setter TargetName="Label" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="24,16,24,20">
        <!-- Version / update -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Padding="14,6" Click="OnUpdate" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" />
                        <TextBlock x:Name="UpdateLabel" Text="Nach Updates suchen" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="KeyTrainer" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Lerne, Windows nur mit der Tastatur zu steuern." />

                <!-- Start -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Ohne Maus steuern" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Du bekommst Ziele wie „Öffne den Ordner Downloads“. Wie du hinkommst, ist egal – nur die Maus ist tabu. Die Aufgabe steht oben am Bildschirmrand, Tipps kommen von selbst." />
                        <Button x:Name="TrainButton" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Margin="0,16,0,0"
                                Padding="24,12" HorizontalAlignment="Left" Click="OnTrain">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TrainIcon" Style="{StaticResource Icon}" FontSize="16" Text="&#xE768;" />
                                <TextBlock x:Name="TrainLabel" FontSize="16" Text="Training starten" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PoolText" Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <CheckBox x:Name="ShowSolutionBox" Margin="0,10,0,0" Content="Schnellsten Weg sofort zeigen (zum Kennenlernen)" />
                        <TextBlock x:Name="SessionText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Areas -->
                <Expander x:Name="AreasExpander" Header="Bereiche" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Extras gehören nicht zum Standard-Training und lassen sich hier dazunehmen." />
                            <WrapPanel x:Name="AreaPanel" />
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Missing software -->
                <Expander x:Name="SoftwareExpander" Header="Fehlende Software" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel x:Name="SoftwarePanel" />
                            <Button Content="Erneut prüfen" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0" Click="OnRecheckSoftware" />
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Detection test and log -->
                <Expander x:Name="DebugExpander" Header="Erkennungstest und Log" Margin="0,0,0,8"
                          Expanded="OnDebugExpanded" Collapsed="OnDebugExpanded">
                    <Border x:Name="DebugArea" Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel Margin="4,0,4,8">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button x:Name="StartButton" Padding="12,6" Margin="0,0,8,0" Click="OnToggle">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="StartIcon" Style="{StaticResource Icon}" Text="&#xE768;" />
                                            <TextBlock x:Name="StartLabel" Text="Erfassung starten" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,6" Margin="0,0,8,0" Click="OnClear">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                            <TextBlock Text="Leeren" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,6" Click="OnOpenLog">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" />
                                            <TextBlock Text="Log-Ordner" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource TextFillColorDisabledBrush}" />
                                    <TextBlock x:Name="StatusText" Text="Erfassung aus" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CountText" Style="{StaticResource Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" Text="0 Eingaben" />
                                </StackPanel>
                            </DockPanel>
                            <Grid MinHeight="120" MaxHeight="320">
                                <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                           Text="Noch keine Eingaben.&#x0a;Starte die Erfassung und drücke z. B. Win + R." />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TokenList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontFamily="Consolas" />
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource KeyPartTemplate}"
                                                                  Visibility="{Binding ComboVisibility}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding TextVisibility}">
                                                        <Border Padding="6,1" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                            <TextBlock Text="Text" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
