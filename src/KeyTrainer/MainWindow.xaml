<Window x:Class="KeyTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyTrainer"
        Icon="app.ico"
        Width="560" Height="680" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- One key cap ("Strg") or the "+" between them -->
        <DataTemplate x:Key="KeyPartTemplate">
            <Border x:Name="Cap" Margin="0,0,4,0" Padding="8,3" CornerRadius="5" BorderThickness="1,1,1,2"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <TextBlock x:Name="Label" Text="{Binding Label}" FontWeight="SemiBold" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="Cap" Property="Background" Value="Transparent" />
                    <Setter TargetName="Cap" Property="BorderThickness" Value="0" />
                    <Setter TargetName="Cap" Property="Padding" Value="0,3" />
                    <Setter TargetName="Label" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Erkennungstest" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Zeigt jede erkannte Tastenkombination – auch wenn ein anderes Programm im Vordergrund ist. Eingaben bleiben im Speicher und werden nie gespeichert." />
        </StackPanel>

        <!-- Actions -->
        <WrapPanel Grid.Row="1" Margin="0,16,0,0">
            <Button x:Name="StartButton" Style="{DynamicResource AccentButtonStyle}" Padding="16,8" Margin="0,0,8,8" Click="OnToggle">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartIcon" Style="{StaticResource Icon}" Text="&#xE768;" />
                    <TextBlock x:Name="StartLabel" Text="Erfassung starten" />
                </StackPanel>
            </Button>
            <Button Padding="14,8" Margin="0,0,8,8" Click="OnClear">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                    <TextBlock Text="Leeren" />
                </StackPanel>
            </Button>
            <Button Padding="14,8" Margin="0,0,8,8" Click="OnOpenLog">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" />
                    <TextBlock Text="Log-Ordner" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Status -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,12">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Center" Text="0 Eingaben" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                             Fill="{DynamicResource TextFillColorDisabledBrush}" />
                    <TextBlock x:Name="StatusText" Text="Erfassung aus" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Detected input -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                           Text="Noch keine Eingaben.&#x0a;Starte die Erfassung und drücke z. B. Win + R." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TokenList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontFamily="Consolas" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource KeyPartTemplate}"
                                                  Visibility="{Binding ComboVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding TextVisibility}">
                                        <Border Padding="6,1" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="Text" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Version / update -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Padding="14,6" Click="OnUpdate" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" />
                        <TextBlock x:Name="UpdateLabel" Text="Nach Updates suchen" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
